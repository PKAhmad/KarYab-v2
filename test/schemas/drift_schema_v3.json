          "sql": "CREATE TABLE IF NOT EXISTS \"saved_searches\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"label\" TEXT NOT NULL, \"params\" TEXT NOT NULL, \"last_run_at\" INTEGER NULL, \"last_top_refnr\" TEXT NULL);"
