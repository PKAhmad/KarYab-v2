    {
      "name": "profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profile\" (\"id\" INTEGER NOT NULL, \"fullName\" TEXT NULL, \"dobDay\" TEXT NULL, \"dobMonth\" TEXT NULL, \"dobYear\" TEXT NULL, \"country\" TEXT NULL, \"phone\" TEXT NULL, \"email\" TEXT NULL, \"street\" TEXT NULL, \"city\" TEXT NULL, \"photoPath\" TEXT NULL, \"skill\" TEXT NULL, \"workExperience\" TEXT NULL, \"workType\" TEXT NULL, \"tools\" TEXT NULL, \"drivingLicense\" TEXT NULL, \"languages\" TEXT NULL, \"languageProficiency\" TEXT NULL, \"availability\" TEXT NULL, \"startDate\" TEXT NULL, \"educationLevel\" TEXT NULL, \"educationOrt\" TEXT NULL, \"educationDuration\" TEXT NULL, \"reference\" TEXT NULL, \"refName\" TEXT NULL, \"refPhone\" TEXT NULL, \"previousEmployers\" TEXT NULL, \"previousJobTitles\" TEXT NULL, \"previousJobDurations\" TEXT NULL, \"sharedWorkOrts\" TEXT NULL, \"sharedWorkTypes\" TEXT NULL, \"sharedItSkills\" TEXT NULL, \"ausbildungEduInstitutions\" TEXT NULL, \"ausbildungEduOrts\" TEXT NULL, \"ausbildungEduTypes\" TEXT NULL, \"ausbildungEduAbschluss\" TEXT NULL, \"ausbildungEduDurations\" TEXT NULL, \"ausbildungEduGrades\" TEXT NULL, \"ausbildungEscoSkills\" TEXT NULL, \"ausbildungTargetOccupation\" TEXT NULL, \"ausbildungTargetOccupationUri\" TEXT NULL, \"schulabschluss\" TEXT NULL, \"schulabschlussNote\" TEXT NULL, \"extraData\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cv_documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cv_documents\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"template_id\" TEXT NULL, \"accent_color\" TEXT NULL, \"font_size\" TEXT NULL, \"spacing\" TEXT NULL, \"show_photo\" INTEGER NULL CHECK (\"show_photo\" IN (0, 1)), \"payload\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "letter_documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"letter_documents\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"company\" TEXT NULL, \"job_title\" TEXT NULL, \"payload\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "certificates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"certificates\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"label\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"file_path\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
