        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"saved_jobs\" (\"refnr\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"company\" TEXT NOT NULL, \"location\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"saved_at\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, PRIMARY KEY (\"refnr\"));"
        }
      ]
    },
    {
      "name": "saved_searches",
